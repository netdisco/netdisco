<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Netdisco API</title>
    <link rel="stylesheet" type="text/css" href="[% uri_base | none %]/swagger-ui/swagger-ui.css">
    <link rel="icon" type="image/png" href="[% uri_base | none %]/swagger-ui/favicon-32x32.png" sizes="32x32">
    <link rel="icon" type="image/png" href="[% uri_base | none %]/swagger-ui/favicon-16x16.png" sizes="16x16">
    <style>
      html { box-sizing: border-box; overflow-y: scroll; }
      *, *:before, *:after { box-sizing: inherit; }
      body { margin: 0; background: #fafafa; }
    </style>
  </head>

  <body>
    <div id="swagger-ui"></div>

    [%# netdisco-swagger.js reads SwaggerUIBundle at load time, so it comes last. %]
    <script src="[% uri_base | none %]/swagger-ui/swagger-ui-bundle.js"></script>
    <script src="[% uri_base | none %]/swagger-ui/swagger-ui-standalone-preset.js"></script>
    <script src="[% uri_base | none %]/javascripts/netdisco-swagger.js?v=[% asset_version | none %]"></script>
  </body>
</html>
