<i class="nd_sidebar-toggle fas fa-wrench fa-lg" id="nd_sidebar-toggle-img-out"
  rel="tooltip" data-bs-placement="left" data-bs-title="Show Sidebar"></i>
<div class="container-fluid">
  <div class="nd_sidebar nd_sidebar-pinned">
    <div class="card">
      <div class="card-body">
        <i class="nd_sidebar-toggle fas fa-arrow-right-from-bracket" id="nd_sidebar-toggle-img-in"
          rel="tooltip" data-bs-placement="left" data-bs-title="Hide Sidebar" data-bs-container="body"></i>
        <i class="nd_sidebar-pin fas fa-thumbtack nd_sidebar-pin-clicked"
          rel="tooltip" data-bs-placement="left" data-bs-title="Unpin Sidebar" data-bs-container="body"></i>

        <div class="tab-content">
          <div id="[% report.tag | html_entity %]_search" class="tab-pane active">
            <form id="[% report.tag | html_entity %]_form" class="nd_sidebar-form form-stacked"
                method="get" action="[% uri_for('/report') | none %]"
                hx-get="[% uri_for('/ajax/content/report/' _ report.tag) | none %]"
                hx-target="#[% report.tag | html_entity %]_pane"
                hx-sync="closest .nd_sidebar:replace"
                hx-headers='{"X-Requested-With": "XMLHttpRequest"}'
                hx-indicator="#[% report.tag | html_entity %]_indicator"
                data-nd-tab="[% report.tag | html_entity %]"[%
                  # PRE_CHOMP is on, so the newline before a directive is eaten;
                  # the separating space has to live inside the block.
                  IF report.rconfig.bind_params.size AND NOT report.rconfig.show_sidebar %] data-nd-hide-sidebar="1"[% END %]>
              [% TRY %]
              <input type="hidden" data-nd-has-sidebar="[% report.tag | html_entity %]" value="1">
              [% INCLUDE "sidebar/report/${report.tag}.tt" %]
              [% CATCH %]
              <input type="hidden" data-nd-has-sidebar="[% report.tag | html_entity %]" value="[% report.rconfig.bind_params.size ? '1' : '0' %]">
              [% INCLUDE "sidebar/report/generic_report.tt" %]
              [% END %]
            </form>
          </div> <!-- /tab-pane -->
        </div> <!-- /tab-content -->
      </div>
    </div>
  </div>

  <div class="content">
    <ul id="nd_search-results" class="nav nav-tabs">
      <li class="nav-item"><a id="[% report.tag | html_entity %]_link" class="nav-link active nd_single-tab"
        href="#[% report.tag | html_entity %]_pane">[% report.label | html_entity %]</a></li>
      [% IF report.tag == 'portlog' %]
      <span id="nd_device-name">
        <a href="[% device_ports | none %]&q=[% params.q | uri %]">[% params.q | html_entity %]</a>
        -
        <a href="[% device_ports | none %]&q=[% params.q | uri %]&f=[% params.f | uri %]">[% params.f | html_entity %]</a>
      </span>
      [% ELSIF report.provides_csv %]
      <span id="nd_device-name">
        <a id="nd_csv-download" href="#" download="netdisco.csv">
          <i id="nd_csv-download-icon" class="text-info far fa-file-lines fa-lg"
            rel="tooltip" data-bs-placement="left" data-bs-title="Download as CSV"></i></a>
      </span>
      [% END %]
    </ul>
    <div class="tab-content">
      <div id="[% report.tag | html_entity %]_indicator" class="htmx-indicator col-md-2 alert">
        <i class="fas fa-spinner fa-spin"></i> Waiting for results...
      </div>
      <div class="tab-pane active" id="[% report.tag | html_entity %]_pane"></div>
  </div>
</div>
