<script type="application/json" id="nd-results-report-vrfinconsistency">[% results.replace('<', '\u003c') | none %]</script>
<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-report-vrfinconsistency"
  data-nd-urls='{"report_l3domains": "[% uri_for('/report/l3domains') | html_entity %]"}'
  data-nd-table='{
  "deferRender": true,
  "order": [],
  "columns": [
    {"data":"finding","render":"escape"},
    {"data":"domains","render":{"name":"reportLink","report":"report_l3domains","param":"domain","key":"domain_ids","show":"domains","blankText":"not grouped"}},
    {"data":"vrfs","render":{"name":"join","key":"vrfs","with":", "}},
    {"data":"devices","searchable":false,"render":"number"},
    {"data":"detail","render":"escape"}
  ]
}'>
  <thead>
    <tr>
      <th>Finding</th>
      <th>Domains</th>
      <th>VRFs</th>
      <th>Devices</th>
      <th>Detail</th>
    </tr>
  </thead>
</table>
