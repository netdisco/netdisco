<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-table='{"order":[]}'>
  <thead>
    <tr>
      <th>Finding</th>
      <th>Domain</th>
      <th>VRFs</th>
      <th>Devices</th>
      <th>Detail</th>
    </tr>
  </thead>
  <tbody>
    [% FOREACH row IN results %]
    <tr>
      <td>[% row.finding | html_entity %]</td>
      <td>[% row.domain | html_entity %]</td>
      <td>[% row.vrfs.join(', ') | html_entity %]</td>
      <td>[% row.devices | html_entity %]</td>
      [% IF row.subnet %]
      <td>subnet <a href="[% search_device | none %]&q=[% row.subnet | uri %]&ip=[% row.subnet | uri %]">[% row.subnet | html_entity %]</a>
        between <a href="[% uri_for('/device') | none %]?q=[% row.lo_ip | uri %]">[% (row.lo_dns || row.lo_name || row.lo_ip) | html_entity %]</a>
        and <a href="[% uri_for('/device') | none %]?q=[% row.hi_ip | uri %]">[% (row.hi_dns || row.hi_name || row.hi_ip) | html_entity %]</a></td>
      [% ELSE %]
      <td>[% row.detail | html_entity %]</td>
      [% END %]
    </tr>
    [% END %]
  </tbody>
</table>
