[% IF truncated %]
<div class="alert alert-info">Showing the [% truncated | html_entity %] ports free the longest. Raise the limit in the sidebar, or set it to 0, to see all.</div>
[% END %]
<script type="application/json" id="nd-results-report-portfree">[% results.replace('<', '\u003c') | none %]</script>
<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-report-portfree"
  data-nd-urls='{"device_ports":"[% device_ports | html_entity %]"}'
  data-nd-table='{
  "deferRender": true,
  "order": [],
  "columns": [
    {"data":"ip","render":{"name":"deviceName"}},
    {"data":"port","type":"portsort","render":{"name":"devicePortsLink","q":"ip","f":"data","flags":"c_nodes=on&n_archived=on"}},
    {"data":"name","render":"escape"},
    {"data":"vlan","render":"escape"},
    {"data":"up_admin","searchable":false,"render":"escape"},
    {"data":"up","searchable":false,"render":"escape"},
    {"data":"days_free","className":"nd_center-cell","searchable":false,"render":"number"},
    {"data":"free_since","searchable":false,"render":"dateTime"},
    {"data":"free_since_basis","render":"escape"},
    {"data":"last_macsuck","searchable":false,"render":"dateTime"}
  ]
}'>
  <thead>
    <tr>
      <th>Device</th>
      <th>Port</th>
      <th>Port Description</th>
      <th>VLAN</th>
      <th>Admin Status</th>
      <th>Oper Status</th>
      <th class="nd_center-cell">Days Free</th>
      <th>Free Since</th>
      <th>Based On</th>
      <th>Device Last Macsuck</th>
    </tr>
  </thead>
</table>
