[% USE CSV -%]
[% CSV.dump([ 'Finding' 'Domains' 'VRFs' 'Devices' 'Detail' ]) %]

[% FOREACH row IN results %]
  [% mylist = [] %]
  [% mylist.push(row.finding) %]
  [% mylist.push(row.domains) %]
  [% mylist.push(row.vrfs.join(',')) %]
  [% mylist.push(row.devices) %]
  [% mylist.push(row.detail) %]
  [% CSV.dump(mylist) %]

[% END %]
