[% USE url %]
[% IF opt %]
  <table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
    data-nd-urls='{"search_node":"[% search_node | html_entity %]"}'
    data-nd-table='{"serverSide":true,"order":[[0,"asc"],[5,"desc"]],"ajax":"[% uri_for("/ajax/content/report/netbios/data") | html_entity %]?[% url(params("query").hash) | none %]","columns":[{"data":"domain","render":"blankDomain"},{"data":"mac","render":{"name":"searchNodeLink","upper":true,"always":true}},{"data":"nbname","render":{"name":"searchNodeLink","domainPrefix":true,"always":true}},{"data":"nbuser","render":"nbUser"},{"data":"time_first","render":"dateTime"},{"data":"time_last","render":"dateTime"}]}'>
    <thead>
      <tr>
        <th>Domain</th>
        <th>Node</th>
        <th>Name</th>
        <th>User</th>
        <th>First Seen</th>
        <th>Last Seen</th>
      </tr>
    </thead>
  </table>
[% ELSE %]
<script type="application/json" id="nd-results-report-netbios">[% results.replace('<', '\u003c') | none %]</script>
  <table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
    data-nd-data="#nd-results-report-netbios"
    data-nd-urls='{"report_netbios":"[% uri_for('/report/netbios') | html_entity %]"}'
    data-nd-table='{"deferRender":true,"order":[[1,"desc"]],"columns":[{"data":"domain","render":{"name":"reportLink","report":"report_netbios","param":"domain","blankText":"(Blank Domain)"}},{"data":"count","render":"number"}]}'>
    <thead>
      <tr>
        <th>Domain</th>
        <th>Count</th>
      </tr>
    </thead>
  </table>
[% END %]
