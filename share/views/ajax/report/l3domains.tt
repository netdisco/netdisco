<script type="application/json" id="nd-results-report-l3domains">[% results.replace('<', '\u003c') | none %]</script>
<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-report-l3domains"
  data-nd-urls='{
  "device": "[% uri_for('/device') | html_entity %]",
  "report_l3domains": "[% uri_for('/report/l3domains') | html_entity %]"
}'
  data-nd-table='{
  "deferRender": true,
  "order": [],
  "columns": [
    {"data":"ip","render":{"name":"deviceLink","tab":"addresses","label":{"dns":"dns","name":"device_name","ip":"ip"}}},
    {"data":"vrf","render":"escape"},
    {"data":"domain","render":{"name":"reportLink","report":"report_l3domains","param":"domain","key":"domain_id","show":"domain"}},
    {"data":"grouped_by","render":"escape"},
    {"data":"rd","render":"escape"},
    {"data":"rt_import","render":{"name":"join","key":"rt_import","with":", "}},
    {"data":"rt_export","render":{"name":"join","key":"rt_export","with":", "}},
    {"data":"l3_isid","render":"escape"}
  ]
}'>
  <thead>
    <tr>
      <th>Device</th>
      <th>VRF</th>
      <th>Domain</th>
      <th>Why grouped</th>
      <th>RD</th>
      <th>Import RTs</th>
      <th>Export RTs</th>
      <th>I-SID</th>
    </tr>
  </thead>
</table>
