<script type="application/json" id="nd-results-report-apclients">[% results.replace('<', '\u003c') | none %]</script>
<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-report-apclients"
  data-nd-urls='{"device_ports":"[% device_ports | html_entity %]","device":"[% uri_for('/device') | html_entity %]"}'
  data-nd-table='{
  "deferRender": true,
  "columns": [
    {
      "data": "ip",
      "render": {"name":"deviceLink","label":{"dns":"dns","name":"name","ip":"ip"}}
    },
    {"data":"model","render":"escape"},
    {
      "data": "port",
      "type": "portsort",
      "render": {"name":"devicePortsLink","q":"ip","f":"data","flags":"c_nodes=on&n_ssid=on","text":"port_name"}
    },
    {"data":"port_type","render":"escape"},
    {"data":"ssid","render":"escape"},
    {"data":"mac_count","searchable":false,"render":"number"}
  ]
}'>
  <thead>
    <tr>
      <th>Access Point</th>
      <th>Model</th>
      <th>Interface</th>
      <th>Port Type</th>
      <th>SSID</th>
      <th>Node Count</th>
    </tr>
  </thead>
</table>
