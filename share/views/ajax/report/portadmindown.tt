<script type="application/json" id="nd-results-report-portadmindown">[% results.replace('<', '\u003c') | none %]</script>
<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-report-portadmindown"
  data-nd-urls='{"device_ports":"[% device_ports | html_entity %]"}'
  data-nd-table='{"deferRender":true,"order":[[0,"asc"],[1,"asc"]],"columns":[{"data":"ip","render":{"name":"deviceName"}},{"data":"port","type":"portsort","render":{"name":"devicePortsLink","q":"ip","f":"data","flags":"c_nodes=on"}},{"data":"description","render":"escape"},{"data":"up_admin","orderable":false,"searchable":false,"render":"escape"}]}'>
  <thead>
    <tr>
      <th>Device</th>
      <th>Port</th>
      <th>Port Description</th>
      <th>Admin Status</th>
    </tr>
  </thead>
</table>
