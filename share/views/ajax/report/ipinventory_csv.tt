[% USE CSV %]
[% IF multi_domain %]
[% CSV.dump([ 'Node' 'VRF' 'MAC Address' 'Vendor' 'DNS' 'NetBIOS' 'Time Since Last Seen' ]) %]
[% ELSE %]
[% CSV.dump([ 'Node' 'MAC Address' 'Vendor' 'DNS' 'NetBIOS' 'Time Since Last Seen' ]) %]
[% END %]

[% FOREACH row IN results %]
  [% mylist = [] %]
  [% mylist.push(row.ip) %]
  [% mylist.push(row.vrf == '' ? 'default' : row.vrf) IF multi_domain %]
  [% mylist.push(row.mac) %]
  [% mylist.push(row.vendor) %]
  [% mylist.push(row.dns) %]
  [% mylist.push(row.nbname) %]
  [% mylist.push(row.time_last) %]
  [% CSV.dump(mylist) %]

[% END %]
