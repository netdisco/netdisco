<script type="application/json" id="nd-results-report-vlaninventory">[% results.replace('<', '\u003c') | none %]</script>
<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-report-vlaninventory"
  data-nd-urls='{"search":"[% uri_for('/search') | html_entity %]"}'
  data-nd-table='{"deferRender":true,"columns":[{"data":"vlan","render":{"name":"searchLink","tab":"vlan"}},{"data":"description","render":{"name":"searchLink","tab":"vlan"}},{"data":"dcount","searchable":false,"render":"number"},{"data":"pcount","searchable":false,"render":"number"}]}'>
  <thead>
    <tr>
      <th>VLAN ID</th>
      <th>VLAN Name</th>
      <th>Device Count</th>
      <th>Port Count</th>
    </tr>
  </thead>
</table>
