[% USE url %]
[% IF opt %]
  <table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
    data-nd-urls='{"device":"[% uri_for('/device') | html_entity %]","report_moduleinventory":"[% report_moduleinventory | html_entity %]"}'
    data-nd-table='{"serverSide":true,"searching":false,"order":[[0,"desc"]],"ajax":"[% uri_for("/ajax/content/report/moduleinventory/data") | html_entity %]?[% url(params("query").hash) | none %]","columns":[{"data":"ip","render":{"name":"deviceLink","tab":"modules","label":{"dns":"device.dns","name":"device.name","ip":"ip"}}},{"data":"description","render":{"name":"reportLink","report":"report_moduleinventory","param":"description"}},{"data":"name","render":{"name":"reportLink","report":"report_moduleinventory","param":"name"}},{"data":"class","render":{"name":"reportLink","report":"report_moduleinventory","param":"class","capitalize":true}},{"data":"type","render":{"name":"reportLink","report":"report_moduleinventory","param":"type"}},{"data":"model","render":{"name":"reportLink","report":"report_moduleinventory","param":"model"}},{"data":"serial","render":{"name":"reportLink","report":"report_moduleinventory","param":"serial"}},{"data":"hw_ver","render":"escape"},{"data":"sw_ver","render":"escape"},{"data":"fw_ver","render":"escape"}]}'>
    <thead>
      <tr>
        <th>Device</th>
        <th>Description</th>
        <th>Name</th>
        <th>Class</th>
        <th>Type</th>
        <th>Model</th>
        <th>Serial</th>
        <th>HW Version</th>
        <th>SW Version</th>
        <th>FW Version</th>
      </tr>
    </thead>
  </table>
[% ELSE %]
<script type="application/json" id="nd-results-report-moduleinventory">[% results.replace('<', '\u003c') | none %]</script>
  <table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
    data-nd-data="#nd-results-report-moduleinventory"
    data-nd-urls='{"report_moduleinventory":"[% report_moduleinventory | html_entity %]"}'
    data-nd-table='{"deferRender":true,"columns":[{"data":"class","render":{"name":"reportLink","report":"report_moduleinventory","param":"class","capitalize":true}},{"data":"count","render":"number"}]}'>
    <thead>
      <tr>
        <th>Class</th>
        <th>Count</th>
      </tr>
    </thead>
  </table>
[% END %]
