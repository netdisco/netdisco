<script type="application/json" id="nd-results-report-nodemultiips">[% results.replace('<', '\u003c') | none %]</script>
<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-report-nodemultiips"
  data-nd-urls='{"search_node":"[% search_node | html_entity %]","device_ports":"[% device_ports | html_entity %]"}'
  data-nd-table='{"deferRender":true,"order":[[3,"desc"]],"columns":[{"data":"mac","render":{"name":"searchNodeLink","upper":true,"always":true}},{"data":"vendor","render":"escape"},{"data":"port","render":{"name":"devicePortsLinkNamed","q":"switch","f":"data","flags":"c_nodes=on","label":{"dns":"dns","name":"name","ip":"switch"},"suffix":"data"}},{"data":"ip_count","searchable":false,"render":"number"}]}'>
  <thead>
    <tr>
      <th>MAC</th>
      <th>Vendor</th>
      <th>Location</th>
      <th>IPs</th>
    </tr>
  </thead>
</table>
