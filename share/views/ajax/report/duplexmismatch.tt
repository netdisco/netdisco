<script type="application/json" id="nd-results-report-duplexmismatch">[% results.replace('<', '\u003c') | none %]</script>
<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-report-duplexmismatch"
  data-nd-urls='{"device_ports":"[% device_ports | html_entity %]"}'
  data-nd-table='{"deferRender":true,"columns":[{"data":"left_ip","render":{"name":"deviceName","dns":"left_dns","ip":"left_ip"}},{"data":"left_port","type":"portsort","render":{"name":"devicePortsLink","q":"left_dns","f":"data","flags":"c_duplex=on","qFallback":"left_ip"}},{"data":"left_duplex","render":"capitalize"},{"data":"right_ip","render":{"name":"deviceName","dns":"right_dns","ip":"right_ip"}},{"data":"right_port","type":"portsort","render":{"name":"devicePortsLink","q":"right_dns","f":"data","flags":"c_duplex=on","qFallback":"right_ip"}},{"data":"right_duplex","render":"capitalize"}]}'>
  <thead>
    <tr>
      <th>Left Device</th>
      <th>Port</th>
      <th>Duplex</th>
      <th>Right Device</th>
      <th>Port</th>
      <th>Duplex</th>
    </tr>
  </thead>
</table>
