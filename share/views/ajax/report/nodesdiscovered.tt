<script type="application/json" id="nd-results-report-nodesdiscovered">[% results.replace('<', '\u003c') | none %]</script>
<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-report-nodesdiscovered"
  data-nd-urls='{"device_ports":"[% device_ports | html_entity %]","search_node":"[% search_node | html_entity %]"}'
  data-nd-table='{
  "deferRender": true,
  "columns": [
    {"data":"ip","render":{"name":"deviceName"}},
    {"data":"port","type":"portsort","render":{"name":"devicePortsLink","q":"ip","f":"data","flags":"c_nodes=on"}},
    {"data":"remote_id","render":"escape"},
    {"data":"remote_ip","render":{"name":"searchNodeLink","always":true}},
    {"data":"remote_port","render":"escape"},
    {"data":"remote_type","render":"escape"}
  ]
}'>
  <thead>
    <tr>
      <th>Device</th>
      <th>Port</th>
      <th>Remote ID</th>
      <th>Remote IP</th>
      <th>Remote Port</th>
      <th>Remote Type</th>
    </tr>
  </thead>
</table>
