[% USE CSV %]
[% IF multi_domain %]
[% CSV.dump([ 'Subnet' 'VRF' 'Size' 'Number of Active Nodes' 'Percent Utilization' ]) %]
[% ELSE %]
[% CSV.dump([ 'Subnet' 'Size' 'Number of Active Nodes' 'Percent Utilization' ]) %]
[% END %]

[% FOREACH row IN results %]
  [% mylist = [] %]
  [% mylist.push(row.subnet) %]
  [% mylist.push(row.vrf == '' ? 'default' : row.vrf) IF multi_domain %]
  [% mylist.push(row.subnet_size) %]
  [% mylist.push(row.active) %]
  [% mylist.push(row.percent) %]
  [% CSV.dump(mylist) %]

[% END %]


