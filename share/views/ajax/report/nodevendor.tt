[% USE url %]
[% IF opt %]
  <table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
    data-nd-urls='{
    "search_node": "[% search_node | html_entity %]",
    "report_nodevendor": "[% uri_for('/report/nodevendor') | html_entity %]",
    "device": "[% uri_for('/device') | html_entity %]",
    "device_ports": "[% device_ports | html_entity %]"
  }'
    data-nd-table='{
    "serverSide": true,
    "order": [[0,"desc"]],
    "ajax": "[% uri_for("/ajax/content/report/nodevendor/data") | html_entity %]?[% url(params("query").hash) | none %]",
    "columns": [
      {"data":"mac","render":{"name":"searchNodeLink","upper":true,"mark":true,"always":true}},
      {
        "data": "manufacturer.abbrev",
        "render": {
          "name": "reportLink",
          "report": "report_nodevendor",
          "param": "vendor",
          "key": "manufacturer.abbrev",
          "show": "manufacturer.company",
          "blankText": "(Unknown Vendor)"
        }
      },
      {
        "data": "switch",
        "render": {"name":"deviceLink","label":{"dns":"device.dns","name":"device.name"},"suffix":"switch"}
      },
      {
        "data": "port",
        "render": {"name":"devicePortsLink","q":"switch","f":"data","flags":"c_nodes=on&n_ssid=on&prefer=port","always":true}
      },
      {
        "data": "vlan",
        "render": {"name":"devicePortsLink","q":"switch","f":"data","flags":"c_nodes=on&n_ssid=on&prefer=vlan","always":true}
      }
    ]
  }'>
    <thead>
      <tr>
        <th>MAC</th>
        <th>Vendor</th>
        <th>Device (IP)</th>
        <th>Port</th>
        <th>VLAN</th>
      </tr>
    </thead>
  </table>
[% ELSE %]
<script type="application/json" id="nd-results-report-nodevendor">[% results.replace('<', '\u003c') | none %]</script>
  <table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
    data-nd-data="#nd-results-report-nodevendor"
    data-nd-urls='{"report_nodevendor":"[% uri_for('/report/nodevendor') | html_entity %]"}'
    data-nd-table='{
    "deferRender": true,
    "order": [[1,"desc"]],
    "columns": [
      {
        "data": "vendor",
        "render": {
          "name": "reportLink",
          "report": "report_nodevendor",
          "param": "vendor",
          "key": "abbrev",
          "show": "vendor",
          "blankText": "(Unknown Vendor)"
        }
      },
      {"data":"count","render":"number"}
    ]
  }'>
    <thead>
      <tr>
      <th class="nd_center-cell">Vendor</th>
      <th class="nd_center-cell">Count</th>
      </tr>
    </thead>
  </table>
[% END %]
