[% USE CSV -%]
[% CSV.dump([ 'Access Point' 'IP' 'Model' 'Interface' 'Port Type' 'SSID' 'Node Count' ]) %]

[% FOREACH row IN results %]
  [% mylist = [] %]
  [% mylist.push(row.dns || row.name || row.ip) %]
  [% mylist.push(row.ip) %]
  [% mylist.push(row.model) %]
  [% mylist.push(row.port_name || row.port) %]
  [% mylist.push(row.port_type) %]
  [% mylist.push(row.ssid || 'Unknown') %]
  [% mylist.push(row.mac_count) %]
  [% CSV.dump(mylist) %]

[% END %]
