<script type="application/json" id="nd-results-report-portutilization">[% results.replace('<', '\u003c') | none %]</script>
<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-report-portutilization"
  data-nd-urls='{"device_ports":"[% device_ports | html_entity %]"}'
  data-nd-table='{"deferRender":true,"columns":[{"data":"ip","render":{"name":"devicePortsLinkNamed","q":"data","dns":"dns","ip":"ip"}},{"data":"port_count","searchable":false,"render":"number"},{"data":"ports_in_use","searchable":false,"render":"number"},{"data":"ports_shutdown","searchable":false,"render":"number"},{"data":"ports_free","searchable":false,"render":"number"}]}'>
  <thead>
    <tr>
      <th>Device</th>
      <th class="nd_center-cell">Total Ports</th>
      <th class="nd_center-cell">In Use</th>
      <th class="nd_center-cell">Shutdown</th>
      <th class="nd_center-cell">Free</th>
    </tr>
  </thead>
</table>
