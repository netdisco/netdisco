<script type="application/json" id="nd-results-device-vlans">[% results.replace('<', '\u003c') | none %]</script>
<table id="data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-device-vlans"
  data-nd-urls='{"device_ports":"[% device_ports | html_entity %]","search":"[% uri_for('/search') | html_entity %]"}'
  data-nd-table='{"deferRender":true,"columns":[{"data":"vlan","render":{"name":"devicePortsLink","q":"ip","f":"data","always":true}},{"data":"description","render":{"name":"searchLink","tab":"vlan"}}]}'>
  <thead>
    <tr>
      <th>VLAN ID</th>
      <th>VLAN Name</th>
    </tr>
  </thead>
</table>
