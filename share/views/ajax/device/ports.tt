[%# A frame: the ports loader (data-nd-loader) fetches the columns and rows from
    data-nd-source, which carries this request's query string, and draws only
    the rows on screen. A site's copy without data-nd-loader is still served
    the rows it draws itself. %]
<table id="dp-data-table" class="table table-bordered table-striped" width="100%" cellspacing="0"
  data-nd-loader="ports" data-nd-source="[% data_source | html_entity %]"
  data-nd-urls='{"device_ports":"[% device_ports | html_entity %]","search_node":"[% search_node | html_entity %]","search":"[% uri_for('/search') | html_entity %]","portlog":"[% uri_for('/report/portlog') | html_entity %]","topology":"[% uri_for('/admin/topology') | html_entity %]","portssid":"[% uri_for('/report/portssid') | html_entity %]","nodevendor":"[% uri_for('/report/nodevendor') | html_entity %]","netbios":"[% uri_for('/report/netbios') | html_entity %]","port_nodes":"[% uri_for('/ajax/data/device/port/nodes') | html_entity %]"}'>
  <tbody>
    <tr><td><i class="fas fa-spinner fa-spin"></i> Waiting for results...</td></tr>
  </tbody>
</table>

[% IF params.c_admin AND user_has_role('port_control', device.ip) %]
<div id="nd_portlog" class="nd_modal nd_deep-horizon modal fade" tabindex="-1"
    role="dialog" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-body">
        <blockquote>
          <ul><li><p>Please provide a reason for changing the Port Configuration</p></li></ul>
        </blockquote>
        <select id="nd_portlog-reason" class="form-select" name="reason">
          [% FOREACH pair IN settings.port_control_reasons.pairs %]
            <option[% ' selected="selected"' IF pair.key == 'other' %] value="[% pair.key | html_entity %]">
              [% pair.value | html_entity %]</option>
          [% END %]
        </select>
        <textarea id="nd_portlog-log" class="form-control" rows="2" name="log"
          placeholder="Enter a log message"></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn" data-bs-dismiss="modal" aria-hidden="true">Cancel</button>
        <button id="nd_portlog-submit" class="btn btn-info" data-bs-dismiss="modal">Continue</button>
      </div>
    </div>
  </div>
</div>
[% END %]

