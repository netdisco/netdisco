<table id="da-data-table" class="table table-striped table-bordered" width="100%" cellspacing="0">
  <thead>
    <tr>
      <th>Address</th>
      <th>DNS</th>
[%# This header alone asked to be centered while its own column's data is left
    aligned, so it sat out of line with both its data and its neighbors. The
    class is dropped rather than the data centered, because every other column in
    this table aligns left. %]
      <th>Interface</th>
      <th>Description</th>
      <th>Prefix</th>
    </tr>
  </thead>
</table>

<script type="text/javascript">
$(document).ready(function() {
  var table = $('#da-data-table').dataTable({
    "deferRender": true,
    "data": [% results | none %],
    "columns": [
      {
        "data": 'alias',
        "render": function(data, type, row, meta) {
          return he.encode(data || '');
        }
      }, {
        "data": 'dns',
        "render": function(data, type, row, meta) {
          return he.encode(data || '');
        }
      }, {
        "data": 'port',
        "type": 'portsort',
        "render": function(data, type, row, meta) {
          return type === 'display' ?
            '<a href="[% device_ports | none %]&q=' + encodeURIComponent(row.ip) + '&f=' + encodeURIComponent(data) + '">' + he.encode(data || '') + '</a>' :
            he.encode(data || '');
        }
      }, {
        "data": 'device_port.name',
        "render": function(data, type, row, meta) {
          return he.encode(data || '');
        }
      }, {
        "data": 'subnet',
        "render": function(data, type, row, meta) {
          return '[% IF user_has_role('admin') %]<a class="nd_stealth-link" href="[% uri_base | none %]/report/ipinventory?subnet=' + encodeURIComponent(data) + '"><i rel="tooltip" data-bs-placement="left" data-bs-title="Node Inventory" class="fas fa-laptop"></i></a> <a class="nd_stealth-link nd_node-ext-link" href="[% uri_base | none %]/?device=' + encodeURIComponent(data) + '"><i rel="tooltip" data-bs-placement="left" data-bs-title="Discover Devices here" class="fas fa-magnifying-glass"></i></a>&nbsp;[% END %]'
            + '<a href="[% search_device | none %]&q=' + encodeURIComponent(data) + '&ip=' + encodeURIComponent(data) + '">' + he.encode(data || '') + '</a>';
        }
      }
    ],
[% INCLUDE 'ajax/datatabledefaults.tt' -%]
  });
});
</script>
