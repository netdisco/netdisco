[% PROCESS 'externallinks.tt' -%]
[% FOREACH row IN results %]
  [% SET portname = row.port %]
  [% IF want_links %]
    [% html = INCLUDE external_device_port_links item = row d = device %]
    [% CALL collect(row.port, 'c_links', html) %]
  [% END %]
  [% FOREACH config IN cell_cols %]
    [% NEXT UNLESS permitted_by_acl(row, config) %]
    [% TRY %]
      [% html = INCLUDE "plugin/${config.name}/device_port_column.tt" %]
      [% CALL collect(row.port, config.name, html) %]
    [% CATCH %]
      [% CLEAR %]
    [% END %]
  [% END %]
[% END %]
