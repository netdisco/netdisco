[% USE CSV -%]
[% IF multi_domain %]
[% CSV.dump([ 'Address' 'VRF' 'DNS' 'Interface' 'Description' 'Prefix' ]) %]
[% ELSE %]
[% CSV.dump([ 'Address' 'DNS' 'Interface' 'Description' 'Prefix' ]) %]
[% END %]

[% FOREACH row IN results %]
  [% mylist = [] %]
  [% mylist.push(row.alias) %]
  [% mylist.push(row.vrf) IF multi_domain %]
  [% FOREACH col IN [ row.dns row.port row.device_port.name row.subnet ] %]
    [% mylist.push(col) %]
  [% END %]
  [% CSV.dump(mylist) %]

[% END %]
