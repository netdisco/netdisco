<script type="application/json" id="nd-results-search-device">[% results.replace('<', '\u003c') | none %]</script>
<table id="ds-data-table" class="table table-striped table-bordered" width="100%" cellspacing="0"
  data-nd-data="#nd-results-search-device"
  data-nd-urls='{"device":"[% uri_for('/device') | html_entity %]"}'
  data-nd-table='{
  "deferRender": true,
  "columns": [
    {"data":"ip","render":{"name":"deviceLink","label":{"dns":"dns","name":"name","ip":"ip"}}},
    {"data":"location","render":"escape"},
    {"data":"name","render":"escape"},
    {"data":"model","render":"escape"},
    {"data":"os_ver","type":"versionsort","render":"escape"},
    {"data":"ip","render":"escape"},
    {"data":"serial","render":{"name":"join","key":"module_serials"}},
    {"data":"first_seen_stamp","render":"escape"},
    {"data":"last_discover_stamp","render":"escape"}
  ]
}'>
  <thead>
    <tr>
      <th>Device</th>
      <th>Location</th>
      <th>System Name</th>
      <th>Model</th>
      <th>OS Version</th>
      <th>Management IP</th>
      <th>Serial / Chassis ID</th>
      <th>First Seen</th>
      <th>Last Discovered</th>
    </tr>
  </thead>
</table>
