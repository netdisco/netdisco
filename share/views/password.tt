<div class="container">
  <div class="row nd_hero-row">
    <div class="col-md-8 offset-md-2">
      [% IF vars.passchange_ok %]
      <div class="alert alert-success alert-dismissible fade show">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        Password successfully updated.
      </div>
      [% END %]
      [% IF vars.passchange_failed %]
      <div class="alert alert-danger alert-dismissible fade show">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        Incorrect current password, or new passwords did not match. Please try again.
      </div>
      [% END %]
      <div class="p-5 mb-4 bg-body-tertiary rounded-3">
        <h2>Change Password</h2>
        <form class="nd_login-form" method="post" action="[% uri_for('/password') | none %]">
          <div class="d-flex align-items-center">
            <input placeholder="Current Password" class="form-control" name="old" type="password" required="required"/>
          </div>
          <div class="d-flex align-items-center">
            <input placeholder="New Password" class="form-control" name="new" type="password" required="required"/>
            <input placeholder="Confirm New Password" class="form-control" name="confirm" type="password" required="required"/>
            <button type="submit" class="btn btn-info">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div> <!-- /container -->
