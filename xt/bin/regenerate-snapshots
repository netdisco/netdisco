#!/usr/bin/env perl

# Rewrites every committed template snapshot. Run this after any deliberate
# change to a template, then review the resulting diff before committing.

use strict;
use warnings;

use FindBin;
use Path::Class 'dir';

BEGIN {
    # xt/bin is two levels below the distribution root, unlike the xt/*.t
    # tests that use this same idiom one level up, so this needs parent->parent
    # rather than parent to land on lib/. Without it the CSV plugin loaded by
    # Test::Netdisco::Snapshot's PLUGINS mapping is unfindable, because this
    # script (unlike ./Build test) never puts blib/lib on @INC.
    unshift @INC, dir($FindBin::RealBin)->parent->parent->subdir('lib')->stringify;
}

use File::Basename 'dirname';
use File::Path 'make_path';
use lib 'xt/lib';
use Test::Netdisco::Snapshot qw/render_template all_templates snapshot_path/;

my ($written, @failed) = (0);

foreach my $view (all_templates()) {
    my ($html, $error) = render_template($view);
    if (defined $error) { push @failed, "$view: $error"; next }

    my $path = snapshot_path($view);
    make_path(dirname($path));
    open my $fh, '>:encoding(UTF-8)', $path or die "$path: $!";
    print {$fh} $html;
    close $fh;
    $written++;
}

printf "wrote %d snapshots to xt/snapshots/\n", $written;

# xt/188 renders the *.two-domains.html files from its own stub rows, so it
# writes them itself.
{
    local $ENV{ND_WRITE_DOMAIN_SNAPSHOTS} = 1;
    my $lib = dir($FindBin::RealBin)->parent->parent->subdir('lib')->stringify;
    system($^X, "-I$lib", '-Ixt/lib', 'xt/188-vrf-domain-readers.t') == 0
      or push @failed, 'xt/188-vrf-domain-readers.t (two-domain snapshots)';
}

if (@failed) {
    printf STDERR "%d template(s) failed to render:\n  %s\n",
        scalar(@failed), join("\n  ", @failed);
    exit 1;
}
exit 0;
